+  int                  frame_height;
+
+  ElanpressMatchParams params;
+  double               min_mean;
+  double               min_contrast;
+  double               min_coverage;
+  char                *dump_dir;
+  char                *dump_session;
+  int                  dump_touch;
+
+  /* raw background frame (no finger), row-major */
+  guint16             *background;
+  guint16              calib_mean;
