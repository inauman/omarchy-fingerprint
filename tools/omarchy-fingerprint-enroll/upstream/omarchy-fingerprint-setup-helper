#!/bin/bash

# omarchy:summary=Root half of fingerprint setup, driven by the enrolment overlay through polkit
# omarchy:hidden=true

# Root half of fingerprint setup, driven by the enrolment overlay through
# polkit (org.omarchy.fingerprint.setup, admin password, remembered a few
# minutes). Non-interactive by design; every step prints one line.
#
#   omarchy-fingerprint-setup-helper install       fingerprint packages
#   omarchy-fingerprint-setup-helper enable-pam    sudo, polkit, lock screen
#   omarchy-fingerprint-setup-helper disable-pam   undo enable-pam
#   omarchy-fingerprint-setup-helper status        "ready" | "enrol" | "install"
set -euo pipefail

# Runs before pam_fprintd in every stack: with the lid shut the reader is
# unreachable, so skip fingerprint and fall to the password at once.
GATE="auth      [success=1 default=ignore] pam_exec.so quiet /usr/bin/omarchy-hw-laptop-closed"

status() {
  if grep -qs pam_fprintd.so /etc/pam.d/sudo && [[ -f /etc/pam.d/omarchy-lock-fingerprint ]]; then
    echo ready
  elif omarchy-cmd-present fprintd-enroll; then
    echo enrol
  else
    echo install
  fi
}

install_all() {
  # Same package step as omarchy-setup-security-fingerprint: libfprint-git
  # tracks upstream ahead of the Arch release, and --ask 4 accepts its
  # replacement of stock libfprint in one transaction, so a failed install
  # leaves the existing driver alone.
  if omarchy-pkg-missing libfprint-git fprintd usbutils; then
    echo "Installing fingerprint packages"
    pacman -S --needed --noconfirm --ask 4 -- libfprint-git fprintd usbutils >/dev/null
  fi
  echo "Packages ready"
}

enable_pam() {
  echo "Configuring sudo"
  grep -q pam_fprintd.so /etc/pam.d/sudo || sed -i '1i auth      sufficient pam_fprintd.so' /etc/pam.d/sudo
  grep -q omarchy-hw-laptop-closed /etc/pam.d/sudo || sed -i "/pam_fprintd\.so/i $GATE" /etc/pam.d/sudo

  echo "Configuring polkit"
  if [[ -f /etc/pam.d/polkit-1 ]]; then
    grep -q pam_fprintd.so /etc/pam.d/polkit-1 || sed -i '1i auth      sufficient pam_fprintd.so' /etc/pam.d/polkit-1
    grep -q omarchy-hw-laptop-closed /etc/pam.d/polkit-1 || sed -i "/pam_fprintd\.so/i $GATE" /etc/pam.d/polkit-1
  else
    # Defer to system-auth rather than listing pam_unix, so pam_faillock's
    # lockout and shared tally still cover polkit prompts (see #9873).
    # omarchy:heredoc-expands paths=none -- $GATE is the literal PAM line
    # defined at the top of this file; its only path is the fixed, root-owned
    # /usr/bin/omarchy-hw-laptop-closed, as in omarchy-setup-security-fingerprint.
    tee /etc/pam.d/polkit-1 >/dev/null <<EOF
$GATE
auth      sufficient pam_fprintd.so
auth      include system-auth

account   include system-auth
password  include system-auth
session   include system-auth
EOF
  fi

  echo "Configuring the lock screen"
  cat > /etc/pam.d/omarchy-lock-fingerprint <<'PAM'
#%PAM-1.0
auth       required                    pam_fprintd.so
account    include                     system-local-login
PAM
  echo "Fingerprint login is on"
}

disable_pam() {
  sed -i -e '/pam_fprintd\.so/d' -e '/omarchy-hw-laptop-closed/d' /etc/pam.d/sudo
  [[ -f /etc/pam.d/polkit-1 ]] && sed -i -e '/pam_fprintd\.so/d' -e '/omarchy-hw-laptop-closed/d' /etc/pam.d/polkit-1
  rm -f /etc/pam.d/omarchy-lock-fingerprint
  echo "Fingerprint login is off"
}

case "${1:-}" in
  status) status ;;
  install | enable-pam | disable-pam)
    [[ $EUID -eq 0 ]] || { echo "needs root (run through pkexec)" >&2; exit 1; }
    case $1 in
      install) install_all ;;
      enable-pam) enable_pam ;;
      disable-pam) disable_pam ;;
    esac ;;
  *) echo "usage: $0 status|install|enable-pam|disable-pam" >&2; exit 2 ;;
esac
